# ============================================================================
# AMAS — Autonomous Multi-Agent Automation System Configuration
# ============================================================================

# Default Active LLM Provider: openrouter | groq | codecraft | gemini | custom
DEFAULT_LLM_PROVIDER=groq
# Default Active Model (e.g. openai/gpt-oss-120b, llama-3.3-70b-versatile, meta-llama/llama-3.3-70b-instruct)
DEFAULT_LLM_MODEL=openai/gpt-oss-120b
# Routing Policy: fixed (use selected only) | fallback (failover on 429/timeout) | automatic (smart best)
LLM_PROVIDER_MODE=fallback

# 1. Groq (Ultra-fast inference)
GROQ_API_KEY="your-groq-api-key"

# 2. OpenRouter (Access to 200+ models)
OPENROUTER_API_KEY="your-openrouter-api-key"

# 3. CodeCraft (OpenAI-compatible)
CODECRAFT_API_KEY="your-codecraft-api-key"
CODECRAFT_BASE_URL="https://api.codecraft-ai.com/v1"
CODECRAFT_MODEL="default"

# 4. Google Gemini (Optional)
GEMINI_API_KEY="your-gemini-api-key"

# 5. Custom OpenAI-compatible Provider (Ollama, vLLM, LMStudio, LocalAI, etc.)
CUSTOM_LLM_BASE_URL="http://localhost:11434/v1"
CUSTOM_LLM_API_KEY="optional-api-key"
CUSTOM_LLM_MODEL="llama3"

# System Execution Settings
PORT=3000
PYTHON_PATH=python
