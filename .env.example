# AMAS Environment Variables Template
# ===================================
# Copy this file to .env and fill in your API keys

# Primary LLM Provider (groq, openrouter, codecraft, gemini, custom)
DEFAULT_LLM_PROVIDER=groq
DEFAULT_LLM_MODEL=openai/gpt-oss-120b

# Provider Mode: fixed | fallback | automatic
LLM_PROVIDER_MODE=fallback

# Groq API Key (get from https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key-here

# OpenRouter API Key (get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# CodeCraft API Key
CODECRAFT_API_KEY=your-codecraft-api-key-here
CODECRAFT_BASE_URL=https://api.codecraft-ai.com/v1
CODECRAFT_MODEL=codecraft-standard

# Google Gemini API Key (get from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Custom OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, etc.)
CUSTOM_LLM_BASE_URL=http://localhost:11434/v1
CUSTOM_LLM_API_KEY=local
CUSTOM_LLM_MODEL=llama3

# Tavily Search API Key (get from https://tavily.com) - REQUIRED for live web search
TAVILY_API_KEY=your-tavily-api-key-here

# Exa Search API Key (get from https://exa.ai) - Optional
EXA_API_KEY=your-exa-api-key-here

# Brave Search API Key (get from https://brave.com/search/api/) - Optional
BRAVE_SEARCH_API_KEY=your-brave-search-api-key-here

# Serper (Google Search) API Key (get from https://serper.dev) - Optional
SERPER_API_KEY=your-serper-api-key-here

# Python path (if not in PATH)
# PYTHON_PATH=python3

# Server port
PORT=3000